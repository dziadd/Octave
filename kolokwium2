%zad2
kat_rad = deg2rad(45);
px = 10; %wspolrzedna x punktu obrotu
py = 20; %wspolrzedna y punktu obrotu
shift_x = 100; %dodatkowe przesuniecie x

%przesuwamy o wektor odwrotny do punktu obrotu(-10, -20)
T1 = [1, 0, -px;
      0, 1, -py;
      0, 0, 1];

%macierz obroru R - przeciwnie do wskazowek zegara
c = cos(kat_rad);
s = sin(kat_rad);
R = [c, -s, 0;
     s, c, 0;
     0, 0, 1];

%przesuwamy z powrotem (+10, +10) oraz dodajemy 100 do x
tx_final = px + shift_x;
ty_final = py;

T_final = [1, 0, tx_final;
           0, 1, ty_final;
           0, 0, 1];

%Obliczenie moc- mnozenie od lewej do prawej
MOC = T_final * R* T1;

display('zad 2 macierz obróbki całkowitej MOC:');
display(MOC);


%zad3
%wczytanie danych z pliku(x to kolumna 1, y to kolumna 2)
dane = csvread('punktman.csv');
x = dane(:, 1);
y = dane(:, 2);

n = length(x); %liczba punktow


P = [x';y';ones(1,n)]; %stworzenie wektora punktów w postaci jednorodnej [x; y; 1]

MOC = [1 10 0; 0 100 0; 0 0 1];

%wykonanie przeksztalcenia (mnozenie macierzy przez punkty)
P_nowe = MOC * P;

%wyciągniecie nowych wspolrzednych x (pierwszy wiersz)
x_nowe = P_nowe(1, :);

%znalezienie i wyswietlenie maksymalnej wartosci x
max_x = max(x_nowe);

display('zad 3 maksymalna wartosc x:');
display(max_x);




