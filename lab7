pkg load image;
clear; clc; close all;

function out_img = skaluj_najblizszy_sasiad(img,s_wy, w_wy)
  [w_we, s_we, channels] = size(img);

  if s_wy < 2 || w_wy < 2 || s_we < 2 || w_we < 2
    out_img = imresize(img, [w_wy, s_wy], 'nearest');
    return;
  endif

  vec_x_wy = 1:s_wy;
  vec_y_wy = 1:w_wy;

  scale_x = (s_we - 1) / (s_wy - 1);
  scale_y = (w_we - 1) / (w_wy - 1);

  indices_x = round(1 + (vec_x_wy - 1) * scale_x);
  indices_y = round(1 + (vec_y_wy - 1) * scale_y);

  indices_x = max(1, min(s_we, indices_x));
  indices_y = max(1, min(w_we, indices_y));

  out_img = img(indices_y, indices_x, :);
endfunction

file_rzeczka = 'rzeczka.jpg';
