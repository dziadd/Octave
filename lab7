% --- FUNKCJE POMOCNICZE ---

function out_img = skaluj_najblizszy_sasiad(img, s_wy, w_wy)
    % Implementacja algorytmu "najbliższego sąsiada"
    % s_wy, w_wy - szerokość i wysokość wyjściowa [cite: 227]

    [w_we, s_we, channels] = size(img); % Pobranie wymiarów wejściowych

    % Zabezpieczenie dla obrazów o wymiarze 1x1 lub błędnych danych
    if s_wy < 2 || w_wy < 2 || s_we < 2 || w_we < 2
        out_img = imresize(img, [w_wy, s_wy], 'nearest'); % Fallback
        return;
    end

    % Optymalizacja: Tworzenie wektorów translacji zamiast pętli [cite: 231]

    % Wektory indeksów wyjściowych (od 1 do szerokości/wysokości)
    vec_x_wy = 1:s_wy;
    vec_y_wy = 1:w_wy;

    % Obliczenie indeksów wejściowych wg wzoru z PDF
    % Wzór: x_we = round(1 + (x_wy - 1) * (s_we - 1) / (s_wy - 1))

    scale_x = (s_we - 1) / (s_wy - 1);
    scale_y = (w_we - 1) / (w_wy - 1);

    indices_x = round(1 + (vec_x_wy - 1) * scale_x);
    indices_y = round(1 + (vec_y_wy - 1) * scale_y);

    % Zabezpieczenie przed wyjściem poza zakres (błędy zaokrągleń float)
    indices_x = max(1, min(s_we, indices_x));
    indices_y = max(1, min(w_we, indices_y));

    % Wykorzystanie indeksowania macierzowego do stworzenia obrazu
    % To zastępuje wolne pętle for
    out_img = img(indices_y, indices_x, :);
end
