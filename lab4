%zad 1 gamma
clear;clc;close all;
img = imread('rzeczka.jpg');
img_d = double(img); %zakres 0:255


%wzor z pdf: wyjscie = wejscie^(1/gamma)
% Należy przeskalować wartości do zakresu [0; 1]
gamma = 1.5;
img_gamma_norm = (img_d / 255) .^ (1/gamma);
img_gamma = img_gamma_norm * 255; %powrot do zakresu [0;255]

%funkcja przytnijzakres dla zakresu [0:255]
przytnij = @(x) max(0, min(255,x));

%Porównanie v.PS z mnożnikiem (mnożnik = 4)
%wyjscie = PrzytnijZakres(mnoznik * |wenowe - westare|)
mnoznik_ps = 4;
img_vPS = przytnij(mnoznik_ps * abs(img_gamma - img_d));

%Porównanie v.2 z mnożnikiem (mnożnik = 3)
%wyjscie = PrzytnijZakres(mnoznik * (wenowe - westare) + wartośćŚrodkowa)
mnoznik_v2 = 3;
wartoscSrodkowa = 127.5; % Dla zakresu [0; 255]
img_v2 = przytnij(mnoznik_v2 * (img_gamma - img_d) + wartoscSrodkowa);

figure;
subplot(2,2,1);imshow(uint8(img));title('org');
subplot(2,2,2);imshow(uint8(img_gamma));title('korekcja gamma 1.5');
subplot(2,2,3);imshow(uint8(img_vPS));title('v.Ps * 4');
subplot(2,2,4);imshow(uint8(img_v2));title('v.2 * 3');


%zad2 szarosc
R = img_d(:,:,1);
G = img_d(:,:,2);
B = img_d(:,:,3);

%szarosc srednia arytmetyczna z RGB
szarosc_srednia = (R+G+B) / 3;

%szarosc suma iloczynow z wagami wzor: 0.2126*R + 0.7152*G + 0.0722*B (w pdf)
szarosc_szary = 0.2126 * R + 0.7152 * G + 0.0722 * B;


%porownanie v.PS z mnoznikiem 4
%wzor: mnoznik * |nowe - stare|
mnoznik_ps = 4;
diff_ps = abs(szarosc_szary - szarosc_srednia);
img_vPS = przytnij(mnoznik_ps * diff_ps);

%porownanie v.2 z mnoznikiem 3
% Wzór: mnoznik * (nowe - stare) + wartośćŚrodkowa
mnoznik_v2 = 3;
wartoscSrodkowa = 127.5;
diff_v2 = (szarosc_szary - szarosc_srednia);
img_v2 = przytnij(mnoznik_v2 * diff_v2 + wartoscSrodkowa);

figure;
% 1. Szary(SzarośćSzary)
subplot(2,2,1);
imshow(uint8(szarosc_szary));
title('Szary');

% 2.Średnia(SzarośćŚrednia)
subplot(2,2,2);
imshow(uint8(szarosc_srednia));
title('Srednia');

%3. Porównanie v.PS * 4
subplot(2,2,3);
imshow(uint8(img_vPS));
title('porownanie v.PS * 4');

% 4. Porównanie v.2 * 3
subplot(2,2,4);
imshow(uint8(img_v2));
title('porownanie v.2 * 3');

%zad3 składowe Y'CbCr

R = img_d(:,:,1);
G = img_d(:,:,2);
B = img_d(:,:,3);

%Obliczenia składowych Y'CbCr (wzory z pdf)
Y = 0 + 0.299 * R + 0.587 * G + 0.114*B;
Cb = 128 - 0.168736 * R - 0.331264 * G + 0.5 * B;
Cr = 128 + 0.5 * R - 0.418688 * G - 0.081312 * B;

%przytnij = @(x) max(0, min(255,x)); funkcja przyciecia zakresu juz napisana wyzej

Y = przytnij(Y);
Cb = przytnij(Cb);
Cr = przytnij(Cr);

figure;
subplot(2,2,1);imshow(uint8(img_d));title('Org RGB');
subplot(2,2,2);imshow(uint8(Y));title('Y');
subplot(2,2,3);imshow(uint8(Cb));title('Cb');
subplot(2,2,4);imshow(uint8(Cr));title('Cr');



%zad 4 konwersja obrazka na Y'CbCr i powrot do RGB

R_nowe = Y + 1.402 * (Cr - 128);
G_nowe = Y - 0.344136 * (Cb - 128) - 0.714135 * (Cr - 128);
B_nowe = Y + 1.772 * (Cb - 128);

img_nowy = zeros(size(img_d));
img_nowy(:,:,1) = R_nowe;
img_nowy(:,:,2) = G_nowe;
img_nowy(:,:,3) = B_nowe;

roznica = img_nowy - img_d;
max_err = max(abs(roznica(:)));
if max_err < 0.0001
  disp('Bład jest mniejszy niz 0.0001');
else
  disp('Błąd jest za duży');
end

mnoznik = 1000000;

%porownanie v.PS
comp_vps = przytnij(mnoznik * abs(roznica));

%porownanie v2
comp_v2 = przytnij(mnoznik  * roznica + 127.5);

figure;
subplot(2,2,1);imshow(uint8(img_d));title('Oryginal');
subplot(2,2,2);imshow(uint8(img_nowy));title('Po konwersji RGB->YCBCR->RGB');
subplot(2,2,3);imshow(uint8(comp_vps));title('Roznica v.PS * 1000000');
subplot(2,2,4);imshow(uint8(comp_v2));title('Roznica v.2 * 1000000');


%zad 5

Y = round(Y); %zaokraglenie ycbcr
Cb = round(Cb);
Cr = round(Cr);

R_nowe = Y + 1.402 * (Cr - 128);
G_nowe = Y - 0.344136 * (Cb - 128) - 0.714135 * (Cr - 128);
B_nowe = Y + 1.772 * (Cb - 128);

R_nowe = round(R_nowe); %zaokraglenie rgb
G_nowe = round(G_nowe);
B_nowe = round(B_nowe);

%zlozenie obrazu
img_nowy = zeros(size(img_d));
img_nowy(:,:,1) = R_nowe;
img_nowy(:,:,2) = G_nowe;
img_nowy(:,:,3) = B_nowe;

roznica = img_nowy - img_d;
max_err = max(abs(roznica(:)));

if max_err == 1 %test ile wynosi blad po zaokragleniu
    disp('TEST ZALICZONY: Maksymalna roznica wynosi 1.');
else
    disp(['TEST NIEZALICZONY: Roznica wynosi ' num2str(max_err) ' (oczekiwano 1).']);
end

mnoznik_ps = 250; %porownanie vps z mnoznikiem 250
img_vPS = przytnij(mnoznik_ps * abs(roznica));

mnoznik_v2 = 300; %porownanie v2 z mnoznikiem 300
wartoscSrodkowa = 127.5;
img_v2 = przytnij(mnoznik_v2 * roznica + wartoscSrodkowa);

figure;
subplot(2,2,1);imshow(uint8(img_d));title('RGB org');
subplot(2,2,2);imshow(uint8(img_nowy));title('-> YCbCr -> RGB (zaokraglane)');
subplot(2,2,3);imshow(uint8 (img_vPS));title('porownanie v.PS * 250');
subplot(2,2,4);imshow(uint8 (img_v2));title('porownanie v.2 * 300');


%zad 6
%Obrazek pierwszy: Gamma 1.5 na całym RGB
gamma = 1.5;
img_gamma_norm = (img_d / 255) .^ (1/gamma);
img_gamma_rgb = img_gamma_norm * 255;

% 2. Obrazek drugi: Gamma 1.5 tylko na Y
Y = 0 + 0.299 * R + 0.587 * G + 0.114 * B;
Cb = 128 - 0.168736 * R - 0.331264 * G + 0.5 * B;
Cr = 128 + 0.5 * R - 0.418688 * G - 0.081312 * B;

% Obróbka tylko składowej Y filtrem gamma 1.5
Y_gamma_norm = (Y / 255) .^ (1/gamma);
Y_gamma = Y_gamma_norm * 255;

% Zamiana z powrotem na RGB (używamy Y_gamma oraz starych Cb i Cr)
% Wzory z Zad 4
R_y = Y_gamma + 1.402 * (Cr - 128);
G_y = Y_gamma - 0.344136 * (Cb - 128) - 0.714136 * (Cr - 128);
B_y = Y_gamma + 1.772 * (Cb - 128);

img_y_gamma = zeros(size(img_d));
img_y_gamma(:,:,1) = R_y;
img_y_gamma(:,:,2) = G_y;
img_y_gamma(:,:,3) = B_y;

% Porównanie obu obrazków
roznica = img_y_gamma - img_gamma_rgb;

% Porównanie v.PS z mnożnikiem 50
mnoznik_ps = 50;
img_vPS = przytnij(mnoznik_ps * abs(roznica));

% Porównanie v.2 z mnożnikiem 50
mnoznik_v2 = 50;
wartoscSrodkowa = 127.5;
img_v2 = przytnij(mnoznik_v2 * roznica + wartoscSrodkowa);

figure;
subplot(2,2,1); imshow(uint8(img_gamma_rgb)); title('RGB gamma 1.5');
subplot(2,2,2); imshow(uint8(img_y_gamma)); title('YCbCr, Y gamma 1.5, RGB');
subplot(2,2,3); imshow(uint8(img_vPS)); title('porownanie v.PS * 50');
subplot(2,2,4); imshow(uint8(img_v2)); title('porownanie v.2 * 50');


% --- ZADANIE 7 ---
% Cel: Zwiększenie nasycenia kolorów (Cb, Cr) o 1.5x

% Obliczamy YCbCr od nowa dla oryginału (żeby nie brać tych po gammie)
Y = 0 + 0.299 * R + 0.587 * G + 0.114 * B;
Cb = 128 - 0.168736 * R - 0.331264 * G + 0.5 * B;
Cr = 128 + 0.5 * R - 0.418688 * G - 0.081312 * B;

% Zwiększenie nasycenia
% Wzór: 128 + (wartosc - 128) * Podbicie
podbicie = 1.5;
Cb_new = 128 + (Cb - 128) * podbicie;
Cr_new = 128 + (Cr - 128) * podbicie;

% Powrót do RGB (z nowymi Cb i Cr, Y bez zmian)
R_sat = Y + 1.402 * (Cr_new - 128);
G_sat = Y - 0.344136 * (Cb_new - 128) - 0.714136 * (Cr_new - 128);
B_sat = Y + 1.772 * (Cb_new - 128);

img_sat = zeros(size(img_d));
img_sat(:,:,1) = R_sat;
img_sat(:,:,2) = G_sat;
img_sat(:,:,3) = B_sat;

% Porównanie obrazka nasyconego z oryginałem
roznica = img_sat - img_d;

% Porównanie v.PS z mnożnikiem 10
mnoznik_ps = 10;
img_vPS = przytnij(mnoznik_ps * abs(roznica));

% Porównanie v.2 z mnożnikiem 10
mnoznik_v2 = 10;
img_v2 = przytnij(mnoznik_v2 * roznica + wartoscSrodkowa);

figure;
subplot(2,2,1); imshow(uint8(img_d)); title('org');
subplot(2,2,2); imshow(uint8(img_sat)); title('YCbCr, kolory * 1.5, RGB');
subplot(2,2,3); imshow(uint8(img_vPS)); title('porownanie v.PS * 10');
subplot(2,2,4); imshow(uint8(img_v2)); title('porownanie v.2 * 10');
